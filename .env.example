# Sceneledger PUBLIC LOCAL-DEVELOPMENT EXAMPLES ONLY; never production credentials.
# Export into process environment: no dotenv loader is included.
# Compose supplies its own container database/proxy values.
DATABASE_URL=postgres://whiteboard:whiteboard@localhost:5432/whiteboard
JWT_SECRET=dev-secret-do-not-use-in-prod
VITE_API_URL=http://localhost:3001
VITE_WS_URL=ws://localhost:3001
# DESTRUCTIVE tests only; select a dedicated disposable database ending _test.
SCENELEDGER_TEST_DATABASE_URL=postgres://whiteboard:whiteboard@localhost:55439/sceneledger_test
